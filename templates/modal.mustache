{{!
    @template local_freshdesk/modal

    Support modal opened from the floating Help button. Contains a knowledge
    base search panel, an article viewer, and a contact / ticket form.

    Context variables required for this template:
    * userName - Optional user's full name to display in header
    * icon - Optional icon: Unicode character or image URL (default: 🎓)

    Example context (json):
    {
        "userName": "John Smith",
        "icon": "🎓"
    }
}}
<div id="fd-modal-overlay">
    <div id="fd-modal" role="dialog" aria-modal="true" aria-label="{{#str}}modaltitle, local_freshdesk{{/str}}">
        <div id="fd-modal-header">
            <h2>
                <span aria-hidden="true" class="fd-icon" data-icon="{{icon}}"></span>
                {{#str}}modaltitle, local_freshdesk{{/str}}{{#userName}} — {{userName}}{{/userName}}
            </h2>
            <button id="fd-modal-close" type="button" aria-label="{{#str}}close, local_freshdesk{{/str}}">&times;</button>
        </div>

        <div id="fd-search-panel">
            <div id="fd-search-row">
                <input id="fd-search-input" type="text"
                    placeholder="{{#str}}searchplaceholder, local_freshdesk{{/str}}"
                    aria-label="{{#str}}searchplaceholder, local_freshdesk{{/str}}">
                <button id="fd-search-btn" type="button">{{#str}}searchbutton, local_freshdesk{{/str}}</button>
            </div>
        </div>

        <div id="fd-results">
            <div id="fd-status">{{#str}}initialprompt, local_freshdesk{{/str}}</div>
            <div id="fd-articles"></div>

            <div id="fd-article-view">
                <div id="fd-article-back">
                    <button id="fd-article-back-btn" type="button">&#8592; {{#str}}backtoresults, local_freshdesk{{/str}}</button>
                    <button id="fd-article-open-btn" type="button">{{#str}}openfullarticle, local_freshdesk{{/str}} &#8599;</button>
                </div>
                <div id="fd-article-content"></div>
            </div>

            <div id="fd-contact-form">
                <div id="fd-contact-form-back">
                    <button id="fd-contact-back-btn" type="button">&#8592; {{#str}}back, local_freshdesk{{/str}}</button>
                </div>
                <div id="fd-contact-success">
                    <p id="fd-contact-success-msg">
                        <span aria-hidden="true">&#10003;</span> {{#str}}ticketsubmitted, local_freshdesk{{/str}}
                    </p>
                    <p id="fd-contact-success-sub">{{#str}}ticketreply, local_freshdesk{{/str}}</p>
                </div>
                <div id="fd-contact-fields">
                    <div id="fd-contact-userinfo"></div>
                    <div id="fd-suggest-section">
                        <p id="fd-suggest-heading">{{#str}}relatedheading, local_freshdesk{{/str}}</p>
                        <div id="fd-suggest-articles"></div>
                    </div>
                    <div>
                        <label for="fd-ticket-subject">{{#str}}subjectlabel, local_freshdesk{{/str}}</label>
                        <input id="fd-ticket-subject" type="text" maxlength="255">
                    </div>
                    <div>
                        <label for="fd-ticket-message">{{#str}}messagelabel, local_freshdesk{{/str}}</label>
                        <textarea id="fd-ticket-message"
                            placeholder="{{#str}}messageplaceholder, local_freshdesk{{/str}}"></textarea>
                    </div>
                    <div id="fd-screenshot-area">
                        <button type="button" id="fd-screenshot-attach">
                            <span aria-hidden="true">&#128247;</span> {{#str}}attachscreenshot, local_freshdesk{{/str}}
                        </button>
                        <input id="fd-screenshot-file" type="file" accept="image/*">
                        <div id="fd-screenshot-preview-wrap">
                            <img id="fd-screenshot-img" src="data:," alt="{{#str}}screenshotpreview, local_freshdesk{{/str}}">
                            <button type="button" id="fd-screenshot-clear">
                                &times; {{#str}}removescreenshot, local_freshdesk{{/str}}
                            </button>
                        </div>
                        <p id="fd-screenshot-hint">{{#str}}screenshothint, local_freshdesk{{/str}}</p>
                    </div>
                    <p id="fd-contact-error"></p>
                    <p id="fd-privacy-notice">{{#str}}privacynotice, local_freshdesk{{/str}}</p>
                    <button id="fd-contact-submit" type="button">{{#str}}send, local_freshdesk{{/str}}</button>
                </div>
            </div>
        </div>

        <div id="fd-contact-bar">
            <button id="fd-contact-btn" type="button">
                <span aria-hidden="true">&#9993;</span> {{#str}}contactsupport, local_freshdesk{{/str}}
            </button>
        </div>
    </div>
</div>
